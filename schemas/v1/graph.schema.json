{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graph-coder.local/schemas/graph.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_contract", "artifact_type", "id", "version", "root_id", "bounds", "nodes", "edges"],
  "properties": {
    "artifact_contract": {"const": "graph-coder/v1"}, "artifact_type": {"const": "graph"},
    "id": {"type": "string", "minLength": 1}, "version": {"type": "integer", "minimum": 1}, "root_id": {"type": "string", "minLength": 1},
    "bounds": {"type": "object", "additionalProperties": false, "required": ["max_nodes", "max_depth", "max_fanout", "default_attempt_limit"], "properties": {"max_nodes": {"type": "integer", "minimum": 1}, "max_depth": {"type": "integer", "minimum": 1}, "max_fanout": {"type": "integer", "minimum": 1}, "default_attempt_limit": {"type": "integer", "minimum": 1, "maximum": 10}}},
    "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}}
  },
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "node": {"type": "object", "additionalProperties": false, "required": ["id", "type", "atomicity", "role", "unit_ids", "parent_owner", "dependencies", "artifact_inputs", "artifact_outputs", "read_scope", "write_scope", "acceptance", "review_gate", "route", "risk", "priority", "attempt_limit", "heartbeat_seconds", "expansion_allowed", "child_cap", "failure_domain"], "properties": {
      "id": {"type": "string", "minLength": 1}, "type": {"enum": ["explore", "spike", "implement", "verify", "integrate", "review", "repair", "release"]}, "atomicity": {"enum": ["atomic", "composite"]}, "role": {"type": "string", "minLength": 1},
      "unit_ids": {"$ref": "#/$defs/strings"}, "parent_owner": {"type": ["string", "null"]}, "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
      "artifact_inputs": {"type": "array", "items": {"type": "object"}}, "artifact_outputs": {"type": "array", "items": {"type": "object"}}, "read_scope": {"type": "array", "items": {"type": "string"}}, "write_scope": {"type": "array", "items": {"type": "string"}},
      "acceptance": {"type": "array", "items": {"type": "string"}}, "review_gate": {"type": "object"}, "route": {"type": "object"}, "fallback": {"type": ["object", "null"]},
      "risk": {"enum": ["low", "medium", "high", "critical"]}, "priority": {"enum": ["low", "normal", "high", "critical"]}, "estimated_cost": {"type": ["number", "null"], "minimum": 0},
      "attempt_limit": {"type": "integer", "minimum": 1, "maximum": 10}, "heartbeat_seconds": {"type": "integer", "minimum": 1}, "expansion_allowed": {"type": "boolean"}, "child_cap": {"type": "integer", "minimum": 0},
      "failure_domain": {"enum": ["node", "branch", "graph", "external"]}, "merge_strategy": {"type": ["string", "null"]}
    }},
    "edge": {"type": "object", "additionalProperties": false, "required": ["source", "target"], "properties": {"source": {"type": "string", "minLength": 1}, "target": {"type": "string", "minLength": 1}, "artifact": {"type": ["string", "null"]}}}
  }
}
