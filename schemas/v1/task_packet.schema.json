{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graph-coder.local/schemas/task-packet.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["artifact_contract", "artifact_type", "id", "version", "plan_id", "plan_version", "graph_id", "graph_version", "node_id", "unit_id", "attempt", "objective", "input_artifacts", "instructions", "inspect_targets", "read_scope", "write_scope", "forbidden_scope", "acceptance", "verification_commands", "stop_conditions", "report_schema"],
  "properties": {
    "artifact_contract": {"const": "agent-planning-system/v1"}, "artifact_type": {"const": "task_packet"}, "id": {"type": "string", "minLength": 1}, "version": {"type": "integer", "minimum": 1},
    "plan_id": {"type": "string", "pattern": "^P-"}, "plan_version": {"type": "integer", "minimum": 1}, "graph_id": {"type": "string", "minLength": 1}, "graph_version": {"type": "integer", "minimum": 1},
    "node_id": {"type": "string", "minLength": 1}, "unit_id": {"type": "string", "pattern": "^U-"}, "attempt": {"type": "integer", "minimum": 1}, "objective": {"type": "string", "minLength": 1},
    "input_artifacts": {"type": "array", "items": {"type": "object"}}, "instructions": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}, "inspect_targets": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "read_scope": {"type": "array", "items": {"type": "string"}}, "write_scope": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "forbidden_scope": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "acceptance": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}, "verification_commands": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}, "stop_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}, "report_schema": {"type": "object"}
  }
}
