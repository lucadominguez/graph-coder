{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-planning-system.local/schemas/review-defect.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["artifact_contract", "artifact_type", "id", "version", "defect_id", "severity", "evidence", "affected_ids", "affected_section", "consequence", "proposed_resolution", "reviewer_identity", "model_receipt", "status"],
  "properties": {
    "artifact_contract": {"const": "agent-planning-system/v1"}, "artifact_type": {"const": "review_defect"}, "id": {"type": "string", "minLength": 1}, "version": {"type": "integer", "minimum": 1},
    "defect_id": {"type": "string", "minLength": 1}, "severity": {"enum": ["P0", "P1", "P2", "P3"]}, "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}, "affected_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}, "affected_section": {"type": "string", "minLength": 1}, "consequence": {"type": "string", "minLength": 1}, "proposed_resolution": {"type": "string", "minLength": 1}, "decision_needed": {"type": ["string", "null"]}, "reviewer_identity": {"type": "string", "minLength": 1}, "model_receipt": {"type": "string", "minLength": 1}, "status": {"enum": ["open", "resolved", "rejected-with-evidence"]}
  }
}
